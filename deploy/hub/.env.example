STOCKAI_HUB_DOMAIN=sync.example.com
STOCKAI_HUB_PUBLIC_URL=https://sync.example.com
STOCKAI_HUB_SPACE_BYTES=1073741824
STOCKAI_BACKUP_RECIPIENT=age1_REPLACE_WITH_OPERATOR_PUBLIC_RECIPIENT
