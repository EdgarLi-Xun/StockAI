# Copy to .env and replace each example before initializing. Never commit .env.
STOCKAI_DOMAIN=research.example.com
STOCKAI_PUBLIC_URL=https://research.example.com
STOCKAI_BACKUP_RECIPIENT=age1_REPLACE_WITH_OPERATIONS_PUBLIC_RECIPIENT
STOCKAI_CLOUD_SMTP_HOST=smtp.example.com
STOCKAI_CLOUD_SMTP_PORT=465
STOCKAI_CLOUD_SMTP_USER=no-reply@example.com
STOCKAI_CLOUD_SMTP_PASSWORD=REPLACE_LOCALLY
STOCKAI_CLOUD_SMTP_FROM=no-reply@example.com
STOCKAI_CLOUD_SMTP_STARTTLS=0
# Trusted server-side instance only. Do not publish its port.
STOCKAI_CLOUD_OLLAMA_ENABLED=0
STOCKAI_CLOUD_OLLAMA_URL=http://host.docker.internal:11434
